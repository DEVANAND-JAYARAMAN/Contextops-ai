# ContextOps Environment Configuration
# Copy this file to .env and fill in the values

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_CORS_ORIGINS=http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8000

# LLM Configuration (fill during implementation)
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=

# Graph
FALKORDB_GRAPH_NAME=contextops
